# RUNTIME
NODE_ENV=development
PORT=3000
HOST=localhost
API_PREFIX=/api
LOG_LEVEL=debug

# MONGODB
MONGODB_URI=mongodb+srv://kanban-colab:<YOUR_DB_PASSWORD>@cluster0.xxxxx.mongodb.net/kanban-collab?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# REDIS
REDIS_URL=redis://default:<YOUR_REDIS_PASSWORD>@<your-redis-host>:<port>
REDIS_KEY_PREFIX=kanban:
REDIS_YJS_CHANNEL=kanban:yjs:updates
REDIS_NOTIF_CHANNEL=kanban:notifications

# AUTH
JWT_SECRET=<PASTE_A_96_CHAR_HEX_STRING_HERE>
JWT_REFRESH_SECRET=<PASTE_A_DIFFERENT_96_CHAR_HEX_STRING_HERE>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d
BCRYPT_ROUNDS=12

# OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

OAUTH_STATE_SECRET=
OAUTH_STATE_COOKIE_NAME=oauth_state

# CORS
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# WEBSOCKET / YJS
WS_PATH=/ws
WS_MAX_PAYLOAD=1048576
WS_HEARTBEAT_INTERVAL_MS=30000
YJS_SNAPSHOT_INTERVAL_MS=300000
YJS_SNAPSHOT_DEBOUNCE_MS=5000

# STORAGE
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_TEMP_DIR=./uploads/temp
UPLOAD_MAX_SIZE_MB=25

AWS_REGION=auto
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# EMAIL / SMS / PUSH
EMAIL_PROVIDER=console
EMAIL_FROM=Kanban Collab <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# NOTIFICATIONS
NOTIF_DIGEST_CRON=0 8 * * *
NOTIF_DUE_REMINDER_CRON=*/15 * * * *
NOTIF_DUE_SOON_WINDOW_HOURS=24
NOTIF_BATCH_SIZE=200
NOTIF_TTL_READ_DAYS=90

# SCHEDULER / RATE LIMIT / OBSERVABILITY
SCHEDULER_ENABLED=true
WORKSPACE_CLEANUP_CRON=0 * * * *
SELF_PING_CRON=*/10 * * * *
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
OTEL_ENABLED=false
OTEL_SERVICE_NAME=kanban-collab-server
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics

# SECURITY (optional — both fall back to `NODE_ENV === "production"` when unset)
COOKIE_DOMAIN=
COOKIE_SECURE=
TRUST_PROXY=

# RENDER KEEP-ALIVE
# Self-ping keeps a Render Free instance from spinning down. RENDER_EXTERNAL_URL
# is injected by Render automatically — leave it blank locally. Set SELF_PING_URL
# only to override it (custom domain or another host).
SELF_PING_URL=
RENDER_EXTERNAL_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Validated by server/src/config/env.ts at boot (missing/invalid → exit 1).
# Required (no default): MONGODB_URI, REDIS_URL, JWT_SECRET, JWT_REFRESH_SECRET.
# Everything else above has a built-in default — omit it to use that value.
#
# Cross-field rules:
#   • production: JWT_SECRET / JWT_REFRESH_SECRET must not be insecure defaults
#     (no "change-me"/"replace") and must differ from each other.
#   • Google OAuth: GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET +
#     GOOGLE_REDIRECT_URI — all three or none.
#   • GitHub OAuth: GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET +
#     GITHUB_REDIRECT_URI — all three or none.
#   • EMAIL_PROVIDER=smtp   requires SMTP_HOST and SMTP_USER.
#   • SMS_PROVIDER=twilio   requires TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN.
#   • PUSH_ENABLED=true     requires VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY.
#   • STORAGE_PROVIDER != local requires S3_BUCKET_NAME.
# ─────────────────────────────────────────────────────────────────────────────

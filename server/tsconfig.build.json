{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "removeComments": true,
    "declaration": false,
    "rootDir": "./src"
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/scripts/**"
  ],
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}

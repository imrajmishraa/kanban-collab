# RUNTIME
NODE_ENV=development
PORT=5000
HOST=localhost
API_PREFIX=/api
LOG_LEVEL=debug

# MONGODB
MONGODB_URI=mongodb+srv://kanban-colab:<YOUR_DB_PASSWORD>@cluster0.xxxxx.mongodb.net/kanban-collab?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# REDIS
REDIS_URL=redis://default:<YOUR_REDIS_PASSWORD>@<your-redis-host>:<port>
REDIS_KEY_PREFIX=kanban:
REDIS_YJS_CHANNEL=kanban:yjs:updates
REDIS_NOTIF_CHANNEL=kanban:notifications

# AUTH
JWT_SECRET=<PASTE_96_CHAR_HEX_STRING_HERE>
JWT_REFRESH_SECRET=<PASTE_A_DIFFERENT_96_CHAR_HEX_STRING_HERE>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d
BCRYPT_ROUNDS=12

# OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

OAUTH_STATE_SECRET=
OAUTH_STATE_COOKIE_NAME=oauth_state

# CORS
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# WEBSOCKET / YJS
WS_PATH=/ws
WS_MAX_PAYLOAD=1048576
WS_HEARTBEAT_INTERVAL_MS=30000
YJS_SNAPSHOT_INTERVAL_MS=300000
YJS_SNAPSHOT_DEBOUNCE_MS=5000

# STORAGE
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_TEMP_DIR=./uploads/temp
UPLOAD_MAX_SIZE_MB=25

AWS_REGION=auto
S3_BUCKET_NAME=

# EMAIL / SMS / PUSH
EMAIL_PROVIDER=console
EMAIL_FROM=Kanban Collab <no-reply@localhost>
SMS_PROVIDER=console
PUSH_ENABLED=false

# NOTIFICATIONS
NOTIF_DIGEST_CRON=0 8 * * *
NOTIF_DUE_REMINDER_CRON=*/15 * * * *
NOTIF_DUE_SOON_WINDOW_HOURS=24
NOTIF_BATCH_SIZE=200
NOTIF_TTL_READ_DAYS=90

# SCHEDULER / RATE LIMIT / OBSERVABILITY
SCHEDULER_ENABLED=true
WORKSPACE_CLEANUP_CRON=0 * * * *
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
OTEL_ENABLED=false
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
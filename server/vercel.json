{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" },
    { "source": "/readyz", "destination": "/api" },
    { "source": "/websocket", "destination": "/api" },
    { "source": "/ws", "destination": "/api" },
    { "source": "/", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/cron/notification-digest",
      "schedule": "0 8 * * *"
    }
  ]
}

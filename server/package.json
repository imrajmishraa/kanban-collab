{
  "name": "kanban-collaboration-server",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Kanban Collaboration Platform Backend — REST & WebSocket real-time sync server",
  "author": "Raj Mishra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imrajmishraa/kanban-collab.git",
    "directory": "server"
  },
  "homepage": "https://github.com/imrajmishraa/kanban-collab#readme",
  "bugs": {
    "url": "https://github.com/imrajmishraa/kanban-collab/issues"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "// ── Development ──────────────────────────────────────": "",
    "dev": "nodemon --watch src -e ts,json --exec \"ts-node --files src/main.ts\"",
    "dev:debug": "nodemon --watch src -e ts --exec \"node --inspect=0.0.0.0:9229 -r ts-node/register src/main.ts\"",
    "dev:pretty": "NODE_ENV=development nodemon --watch src -e ts --exec \"ts-node --files src/main.ts\" | pino-pretty",
    "// ── Build ────────────────────────────────────────────": "",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist coverage .tsbuildinfo",
    "rebuild": "npm run clean && npm run build",
    "prebuild": "npm run typecheck",
    "// ── Production ───────────────────────────────────────": "",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "start:prod": "NODE_ENV=production node --disable-warning=ExperimentalWarning --enable-source-maps dist/main.js",
    "start:cluster": "NODE_ENV=production node --disable-warning=ExperimentalWarning --max-old-space-size=2048 dist/main.js",
    "// ── Code Quality ─────────────────────────────────────": "",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "// ── Testing ──────────────────────────────────────────": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=lcov",
    "test:ci": "jest --ci --runInBand --coverage --forceExit",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "// ── Database & Seed (scripts not implemented yet) ────": "",
    "// ── Verification & CI ────────────────────────────────": "",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "ci": "npm ci && npm run verify && npm run build",
    "precommit": "npm run check && npm run test",
    "// ── Security & Audit ─────────────────────────────────": "",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "outdated": "npm outdated",
    "security": "npm audit && npm outdated",
    "// ── Docker (single image) ────────────────────────────": "",
    "docker:build": "docker build -t kanban-collab-server:latest -f Dockerfile .",
    "docker:build:prod": "docker build -t kanban-collab-server:prod --target runner -f Dockerfile .",
    "docker:run": "docker run --rm --init -p 3000:3000 --env-file .env -e NODE_ENV=production --name kanban-server kanban-collab-server:latest",
    "docker:run:detached": "docker run -d --init -p 3000:3000 --env-file .env -e NODE_ENV=production --name kanban-server kanban-collab-server:latest",
    "docker:stop": "docker stop kanban-server || true && docker rm kanban-server || true",
    "docker:logs": "docker logs -f kanban-server",
    "docker:shell": "docker exec -it kanban-server sh",
    "docker:stats": "docker stats kanban-server --no-stream",
    "docker:prune": "docker system prune -f",
    "// ── Docker Compose (full stack) ──────────────────────": "",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:restart": "docker compose restart",
    "compose:ps": "docker compose ps",
    "compose:logs": "docker compose logs -f",
    "compose:logs:api": "docker compose logs -f api",
    "compose:shell:api": "docker compose exec api sh",
    "compose:down:volumes": "docker compose down -v",
    "// ── Docker Compose (infra only, for local dev) ───────": "",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "// ── Utilities ────────────────────────────────────────": "",
    "healthz": "curl -s http://localhost:3000/healthz | jq . || echo 'Server not running'",
    "readyz": "curl -s http://localhost:3000/readyz | jq . || echo 'Server not running'",
    "kill:port": "npx kill-port 3000",
    "prepare": "echo 'Ready'"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.117",
    "mongoose": "^8.2.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pino": "^8.19.0",
    "pino-roll": "^4.0.0",
    "redis": "^4.6.13",
    "ws": "^8.16.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "uuid": "^14.0.2"
  },
  "overrides": {
    "glob": "^11.0.1",
    "y-leveldb": "^0.2.0"
  }
}

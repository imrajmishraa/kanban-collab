{
  "name": "kanban-collaboration-server",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Kanban Collaboration Platform Backend — REST & WebSocket sync server",
  "license": "MIT",
  "author": "Raj Mishra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imrajmishraa/kanban-collab.git",
    "directory": "server"
  },
  "homepage": "https://github.com/imrajmishraa/kanban-collab#readme",
  "bugs": {
    "url": "https://github.com/imrajmishraa/kanban-collab/issues"
  },
  "main": "dist/main.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node --files src/main.ts",
    "dev:debug": "TS_NODE_FILES=true nodemon --watch src -e ts --exec \"node --inspect -r ts-node/register src/main.ts\"",
    "build": "tsc",
    "clean": "rm -rf dist coverage",
    "rebuild": "npm run clean && npm run build",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "ci": "npm ci && npm run verify && npm run build",
    "docker:build": "docker build -t kanban-collab-server:latest .",
    "docker:run": "docker run --rm --init -p 5000:5000 --env-file .env kanban-collab-server:latest"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.117",
    "mongoose": "^8.2.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pino": "^8.19.0",
    "pino-roll": "^4.0.0",
    "redis": "^4.6.13",
    "ws": "^8.16.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.9.9",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "uuid": "^14.0.2"
  }
}

{
  "name": "kanban-collaboration-server",
  "version": "1.0.0",
  "description": "Enterprise Kanban Collaboration Platform Backend REST & WS Sync Server",
  "main": "dist/interfaces/http/app.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node --files src/main.ts",
    "dev:ws": "nodemon --watch src -e ts --exec ts-node src/interfaces/websockets/servers/server.ts",
    "dev:debug": "TS_NODE_FILES=true nodemon --watch src -e ts --exec \"node --inspect -r ts-node/register src/main.ts\"",
    "build": "tsc",
    "clean": "rm -rf dist coverage",
    "rebuild": "npm run clean && npm run build",
    "start": "node dist/interfaces/http/app.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.0.9",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.117",
    "mongoose": "^8.2.0",
    "node-cron": "^4.6.0",
    "pino": "^8.19.0",
    "pino-roll": "^4.0.0",
    "redis": "^4.6.13",
    "ws": "^8.16.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "multer": "^2.2.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.9.9",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "uuid": "^14.0.2"
  }
}

{
  "compilerOptions": {
    /* ── Language & Module ─────────────────────────────── */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rewriteRelativeImportExtensions": true,

    /* ── Output ────────────────────────────────────────── */
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,

    /* ── Strict Type-Checking ──────────────────────────── */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    /* ── Module Interop & Resolution ───────────────────── */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": true,

    /* ── Emit & Safety ─────────────────────────────────── */
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "preserveConstEnums": true,

    /* ── Types ─────────────────────────────────────────── */
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "test",
    "tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],

  /* ts-node options. `files: true` makes ts-node load the files matched by
     `include` above — notably the global augmentations in
     src/shared/types/*.d.ts (Express.Request.id, etc.). Without it, running
     ts-node without the `--files` CLI flag (e.g. the `dev:debug` script)
     type-checks only what's reachable by import, the augmentations are never
     loaded, and `req.id` fails with TS2339. */
  "ts-node": {
    "files": true
  }
}

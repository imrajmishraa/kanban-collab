{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": false,

    "outDir": "./dist",
    "rootDir": ".",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}

# ── Client environment ───────────────────────────────────────────────
# Copy to `.env` (or `.env.local`) and adjust for your setup.

# Where the dev server proxies API requests (nginx upstream in Docker).
API_UPSTREAM=http://api:3000

# Docker DNS resolver used by nginx.
NGINX_RESOLVER=127.0.0.11

# ── Collaboration WebSocket URL ──────────────────────────────────────
# The client connects to `{VITE_WS_URL}/ws?token=…&boardId=…`.
# Include the `/ws` path (the helper appends it if you omit it).
#
# Local development — the Vite dev server proxies `/ws` to :3000:
#   VITE_WS_URL=ws://localhost:3000/ws
#
# Production:
#   VITE_WS_URL=wss://kanban-collab-server.onrender.com/ws
#
# NOTE: the default below points at production. For local dev, override it
# with the `ws://localhost:3000/ws` value above, otherwise the browser will
# try to open a cross-origin production socket.
VITE_WS_URL=ws//localhost:3000/ws

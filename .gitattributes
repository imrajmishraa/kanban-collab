# Normalise line endings in the repository, not in the working tree.
* text=auto eol=lf

# Windows contributors: keep the entry points CRLF so they run without a
# shebang rewrite.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell and Docker files must stay LF — a CRLF shebang is an exec error.
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
nginx.conf.template text eol=lf

# Binary: never diff, never convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Lockfiles: generated, and a 3000-line diff hides the one line that matters.
package-lock.json -diff linguist-generated=true

# Baselines: generated by `--write-baseline`, reviewed as a whole file.
*-baseline.json -diff
